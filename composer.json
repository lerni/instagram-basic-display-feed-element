{
  "name": "lerni/instagram-basic-display-feed-element",
  "description": "Instagram Feed for Silverstripe Elemental features Basic Display PHP API (instagram_business_basic scope)",
  "type": "silverstripe-vendormodule",
  "license": "BSD-3-Clause",
  "keywords": [
    "silverstripe",
    "elemental",
    "instagram"
  ],
  "homepage": "https://github.com/lerni/instagram-basic-display-feed-element",
  "support": {
    "issues": "https://github.com/lerni/instagram-basic-display-feed-element/issues"
  },
  "require": {
    "silverstripe/framework": "^6.0",
    "dnadesign/silverstripe-elemental": "^6",
    "espresso-dev/instagram-php": "^1"
  },
  "extra": {
    "installer-name": "instagram-feed"
  },
  "autoload": {
    "psr-4": {
      "Kraftausdruck\\InstagramFeed\\": "src/"
    }
  }
}
